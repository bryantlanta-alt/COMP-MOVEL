<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F4F6F9"
    android:padding="24dp">

    <!-- Título do Jogo -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Campo Minado"
        android:textColor="#2C3E50"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp"/>

    <!-- Novo Bloco: Estatísticas e Tempo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvEstatisticas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 Partidas: 0  |  🏆 Vitórias: 0  |  💀 Derrotas: 0"
            android:textSize="14sp"
            android:textColor="#34495E"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Tempo: 0s"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#E67E22"
            android:layout_marginBottom="4dp"/>

        <!-- NOVO: Texto para a contagem de cliques -->
        <TextView
        android:id="@+id/tvCliques"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👆 Cliques: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#E67E22"/>
    </LinearLayout>

    <!-- O Tabuleiro -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:padding="8dp"
        android:orientation="vertical">

        <GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rowCount="8"
            android:columnCount="8"
            android:alignmentMode="alignBounds" />
    </LinearLayout>

    <!-- Botão de Reiniciar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRestart"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="NOVO JOGO"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="30dp"
        android:layout_marginTop="40dp"/>

</LinearLayout>